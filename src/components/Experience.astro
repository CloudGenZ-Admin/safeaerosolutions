<section class="py-24 md:py-32 bg-navy">
  <div class="container mx-auto px-6 max-w-6xl">
    <div class="fade-in mb-14">
      <h2 class="font-heading text-sm tracking-[0.4em] uppercase text-gold mb-3">
        Professional & Consulting Experience
      </h2>
      <div class="w-16 h-[2px] bg-gold mb-8"></div>
    </div>

    <div class="space-y-12">
      {experiences.map((exp, i) => (
        <div class="fade-in border border-navy-medium bg-navy-light/30 p-6 md:p-8 shadow-sm hover:shadow-md transition-shadow relative" style={`transition-delay: ${Math.min(i * 0.05, 0.3)}s`}>
          <div class="absolute top-0 left-0 w-1 h-full bg-gold"></div>

          <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-4">
            <h3 class="font-heading text-lg md:text-xl font-bold uppercase tracking-tight text-gray-200">
              {exp.company}
            </h3>
            <span class="font-mono text-sm text-gold font-semibold shrink-0">
              {exp.date}
            </span>
          </div>

          <h4 class="font-heading text-sm uppercase tracking-widest text-gray-400 mb-4">
            {exp.role}
          </h4>

          <p class="text-gray-300 leading-relaxed mb-6">
            {exp.summary}
          </p>

          <ul class="space-y-3">
            {exp.bullets.map((bullet) => {
              const colonIdx = bullet.indexOf(': ');
              const hasLabel = colonIdx > 0 && colonIdx < 60;
              return (
                <li class="flex items-start gap-3">
                  <div class="w-1.5 h-1.5 rounded-full bg-gold mt-2 shrink-0"></div>
                  <span class="text-sm text-gray-400 leading-relaxed">
                    {hasLabel ? (
                      <><strong class="text-gray-200">{bullet.substring(0, colonIdx)}: </strong>{bullet.substring(colonIdx + 2)}</>
                    ) : (
                      bullet
                    )}
                  </span>
                </li>
              );
            })}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>
